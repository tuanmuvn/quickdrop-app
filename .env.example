# ========================================================
# QuickDrop v1.0 - Environment Configuration Template
# ========================================================

# Server Port (default: 8055)
PORT=8055

# Environment mode: development | production
NODE_ENV=production

# Room Auto-Expiration in Milliseconds (10 minutes = 600,000 ms)
ROOM_TIMEOUT_MS=600000

# WebRTC DataChannel chunk size in bytes (64 KB = 65,536 bytes)
CHUNK_SIZE=65536

# Rate Limiting (maximum requests per minute per IP)
RATE_LIMIT_MAX=100

# CORS Allowed Origin
CORS_ORIGIN="*"

# Optional TURN server (STUN Google is enabled by default)
# TURN_SERVER_URL="turn:your-turn-server.com:3478"
# TURN_USERNAME="quickdrop-user"
# TURN_CREDENTIAL="your-turn-password"

# GEMINI_API_KEY: Injected by AI Studio if used
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
